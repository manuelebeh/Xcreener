{
  "name": "xcreener",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "turbo format",
    "postinstall": "pnpm --filter @xcreener/design-tokens build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.6",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "lint-staged": "^16.1.2",
    "turbo": "^2.5.4"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": "biome check --write --no-errors-on-unmatched"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-86w9-cpqp-85rv",
        "GHSA-mrhx-c7xc-m3w5",
        "GHSA-xcx6-jx8p-x3h5"
      ]
    },
    "overrides": {
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "shell-quote@<1.11.0": "^1.11.0",
      "postcss@<8.5.23": "^8.5.23",
      "nanoid@<3.3.18": "^3.3.18",
      "decode-uri-component@<0.5.0": "^0.5.0",
      "browserslist@<4.28.7": "^4.28.7",
      "@xmldom/xmldom@<0.8.15": "^0.8.15",
      "@xmldom/xmldom@>=0.9.0 <0.9.12": "^0.9.12",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "compression@<1.8.2": "^1.8.2"
    }
  }
}
