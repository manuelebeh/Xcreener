{
  "name": "@snapglow/sdk",
  "version": "0.1.0-beta.1",
  "private": false,
  "type": "module",
  "description": "Official SnapGlow REST API client",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "echo 'source-only package'",
