{
  "extends": ["@xcreener/biome-config/biome.json"],
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.json",
      "!apps/desktop/src-tauri",
      "!**/dist",
      "!**/test-results",
      "!**/playwright-report",
      "!**/target",
      "!**/routeTree.gen.ts"
    ]
  },
  "overrides": [
    {
      "includes": ["apps/mobile/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": "off"
          }
        }
      }
    }
  ]
}
