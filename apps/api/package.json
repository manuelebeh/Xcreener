{
  "name": "@xcreener/api",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development dotenv -e .env.local -- tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node --enable-source-maps dist/index.mjs",
    "start:local": "dotenv -e .env.local -- node --import tsx src/index.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/s3-request-presigner": "^3.1159.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/websocket": "^11.3.4",
    "@napi-rs/canvas": "^0.1.80",
    "@xcreener/api-core": "workspace:*",
    "@xcreener/cloud-core": "workspace:*",
    "@xcreener/collab-core": "workspace:*",
    "@xcreener/editor-core": "workspace:*",
    "@xcreener/integrations-core": "workspace:*",
    "@xcreener/marketplace-core": "workspace:*",
    "@xcreener/render-core": "workspace:*",
    "@xcreener/sync-core": "workspace:*",
    "@xcreener/team-core": "workspace:*",
    "@t3-oss/env-core": "^0.13.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.6",
    "image-size": "^2.0.4",
    "ioredis": "^5.7.0",
    "jose": "^6.2.13",
    "nanoid": "^5.1.16",
    "piscina": "^5.3.2",
    "postgres": "^3.4.7",
    "stripe": "^18.5.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@xcreener/biome-config": "workspace:*",
    "@xcreener/typescript-config": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.2",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  }
}
