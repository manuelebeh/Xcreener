# Server
PORT=8787
NODE_ENV=development

# Database
DATABASE_URL=postgresql://snapglow:snapglow@localhost:5432/snapglow

# Redis
REDIS_URL=redis://localhost:6379

# Auth0 (API verification)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.snapglow.app

# Public web URL for share links
WEB_PUBLIC_URL=http://localhost:3000

# Comma-separated allowed CORS origins (defaults to WEB_PUBLIC_URL when empty)
CORS_ORIGINS=http://localhost:3000,http://localhost:1420,tauri://localhost

# S3-compatible storage (MinIO local / Cloudflare R2 prod)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=snapglow-shares
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# Integration OAuth (Sprint 2b.6 — optional for local dev)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
INTEGRATIONS_REDIRECT_URI=snapglow://integrations/callback

# Stripe billing (Sprint 3.1–3.2 — optional for local dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM_STARTER=
STRIPE_PRICE_TEAM_PRO=

# Auth0 Management API for SSO org creation (Team Pro — optional)
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

# Transactional email (Sprint 3.3–3.4 — optional)
RESEND_API_KEY=
EMAIL_FROM=SnapGlow <notifications@snapglow.app>
SMTP_URL=

# Public API rate limits (Sprint 3.5–3.6 — optional overrides)
# Load tests: raise API_RATE_LIMIT_GENERAL (e.g. 2000) in a dedicated perf env only
API_RATE_LIMIT_GENERAL=120
API_RATE_LIMIT_UPLOAD=20
API_RATE_LIMIT_EXPORT=30

# Server render worker pool (public API export)
RENDER_WORKERS=2
RENDER_TIMEOUT_MS=15000

# Phase 4 — marketplace, affiliates, enterprise OAuth
MARKETPLACE_MODERATOR_SUBS=
REWARDFUL_WEBHOOK_SECRET=
REWARDFUL_API_KEY=
REWARDFUL_PORTAL_URL=https://snapglow.getrewardful.com/signup
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
MS_TEAMS_CLIENT_ID=
MS_TEAMS_CLIENT_SECRET=

# Desktop entitlements (Ed25519). Generate with: pnpm --filter @snapglow/api exec tsx scripts/generate-entitlement-keys.ts
# The matching public key goes in SNAPGLOW_ENTITLEMENT_PUBLIC_KEY when building the desktop app.
ENTITLEMENT_PRIVATE_KEY=
