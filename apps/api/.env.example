# Server
PORT=8787
NODE_ENV=development

# Database
DATABASE_URL=postgresql://snapglow:snapglow@localhost:5432/snapglow

# Redis
REDIS_URL=redis://localhost:6379

# Auth0 (API verification)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.snapglow.app

# Public web URL for share links
WEB_PUBLIC_URL=http://localhost:3000

# S3-compatible storage (MinIO local / Cloudflare R2 prod)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=snapglow-shares
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# Integration OAuth (Sprint 2b.6 — optional for local dev)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
INTEGRATIONS_REDIRECT_URI=snapglow://integrations/callback

# Stripe billing (Sprint 3.1–3.2 — optional for local dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM_STARTER=
STRIPE_PRICE_TEAM_PRO=

# Auth0 Management API for SSO org creation (Team Pro — optional)
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
