# Copy to .env.local for `mise run dev:mobile`. EAS builds read these from EAS environment
# variables instead (see docs/guides/release-signing-mobile.md). All values are
# public: they ship inside the app bundle.

EXPO_PUBLIC_API_URL=http://localhost:8787

# Same Auth0 native application as the desktop (callback xcreener://auth/callback).
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=

# Raw Ed25519 public key (base64url) matching the API's ENTITLEMENT_PRIVATE_KEY.
# Without it every account is treated as free: Xcreener watermark on exports.
EXPO_PUBLIC_ENTITLEMENT_PUBLIC_KEY=
