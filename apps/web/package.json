{
  "name": "@xcreener/web",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "dotenv -e .env.local -- sh -c \"NODE_OPTIONS='--import ./instrument.server.mjs' vite dev --port 3000\"",
    "generate-routes": "tsr generate",
    "build": "pnpm run generate-routes && vite build && cp instrument.server.mjs .output/server",
    "preview": "vite preview",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "start": "node --import ./.output/server/instrument.server.mjs .output/server/index.mjs"
  },
  "dependencies": {
    "@posthog/react": "^1.11.3",
    "@sentry/tanstackstart-react": "^10.42.0",
    "@xcreener/cloud-core": "workspace:*",
    "@xcreener/collab-core": "workspace:*",
    "@xcreener/design-tokens": "workspace:*",
    "@xcreener/editor-core": "workspace:*",
    "@xcreener/i18n": "workspace:*",
    "@xcreener/marketplace-core": "workspace:*",
    "@xcreener/ui": "workspace:*",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-devtools": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/router-plugin": "^1.132.0",
    "dotenv-cli": "^11.0.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260611-123640-7765bcb7",
    "posthog-js": "^1.438.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.6.6",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.1.1",
    "@xcreener/biome-config": "workspace:*",
    "@xcreener/typescript-config": "workspace:*",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "^8.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
