{
  "name": "@xcreener/notion-embed",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "esbuild public/app.js --bundle --outfile=public/dist/app.js --format=iife --target=es2020",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@xcreener/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@xcreener/biome-config": "workspace:*",
    "@xcreener/typescript-config": "workspace:*",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
