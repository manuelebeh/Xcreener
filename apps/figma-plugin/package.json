{
  "name": "@xcreener/figma-plugin",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "esbuild src/code.ts --bundle --outfile=dist/code.js --format=iife --target=es2017 && esbuild src/ui.ts --bundle --outfile=dist/ui.js --format=iife --target=es2017 && node scripts/inline-ui.mjs",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@xcreener/plugin-core": "workspace:*",
    "@xcreener/sdk": "workspace:*"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.119.0",
    "@xcreener/biome-config": "workspace:*",
    "@xcreener/typescript-config": "workspace:*",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  }
}
