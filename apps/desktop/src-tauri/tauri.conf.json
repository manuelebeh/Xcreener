{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapGlow",
  "version": "0.1.0",
  "identifier": "app.snapglow.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SnapGlow",
        "width": 480,
        "height": 640,
        "resizable": true,
        "decorations": false,
        "visible": false
      },
      {
        "label": "capture-overlay",
        "title": "SnapGlow Capture",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "resizable": false,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.posthog.com https://*.i.posthog.com https://*.sentry.io https://*.ingest.sentry.io https://github.com https://api.github.com https://objects.githubusercontent.com"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:snapglow.db"]
    },
    "global-shortcut": null,
    "autostart": null,
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/manuelebeh/ScreenCut/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCMjIzNUMwQjJBRUVDRjYKUldUMjdLNnl3RFVpeTZvc3lFRWo4ZXpRL080ZUlMZVFpaHgrTkcvWVlONXRWWUhvY2tpU1d3QTUK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
