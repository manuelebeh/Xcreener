{
  "name": "@snapglow/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:native": "node scripts/run-native-e2e.mjs",
    "test:e2e:native:ci": "pnpm tauri build --debug && pnpm test:e2e:native"
  },
  "dependencies": {
    "@posthog/react": "^1.7.0",
    "@sentry/react": "^10.42.0",
    "@snapglow/design-tokens": "workspace:*",
    "@snapglow/typescript-config": "workspace:*",
    "@snapglow/ui": "workspace:*",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-sql": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "posthog-js": "^1.358.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@snapglow/biome-config": "workspace:*",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2",
    "@types/mocha": "^10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "^9",
    "@wdio/globals": "^9",
    "@wdio/local-runner": "^9",
    "@wdio/mocha-framework": "^9",
    "@wdio/spec-reporter": "^9",
    "tailwindcss": "^4.1.11",
    "tsx": "^4",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
